# CampusSentinel backend configuration
# Copy this file to ".env" in the same folder and adjust values.
# Never share your real .env file.

# development | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=5000

# Local MongoDB. Use 127.0.0.1 rather than "localhost" (see README).
MONGODB_URI=mongodb://127.0.0.1:27017/campussentinel

# How long (ms) to wait for MongoDB before giving up at startup
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Python FastAPI AI service (video uploads are forwarded to <URL>/videos/upload)
AI_SERVICE_URL=http://127.0.0.1:8000
# How long (ms) to wait for the AI service to accept a video and reply
AI_SERVICE_TIMEOUT_MS=600000

# Video uploads: temporary folder (relative to backend/) and maximum size in MB
UPLOAD_TMP_DIR=storage/tmp-uploads
VIDEO_UPLOAD_MAX_MB=500
