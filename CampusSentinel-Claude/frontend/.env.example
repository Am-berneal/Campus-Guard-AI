# CampusSentinel frontend configuration
# Copy this file to ".env" in the same folder.
# IMPORTANT: every variable starting with VITE_ is embedded into the
# JavaScript sent to the browser. Never put secrets here.

# Base URL the browser uses for API calls.
# "/api" means "same origin as the page" — the Vite dev server forwards it
# to the backend (see vite.config.js), so no CORS setup is needed in development.
VITE_API_URL=/api

# How often (ms) the dashboard re-checks GET /api/health
VITE_HEALTH_POLL_INTERVAL_MS=15000

# Where the Vite dev server forwards /api requests (development only, not sent to the browser).
BACKEND_PROXY_TARGET=http://127.0.0.1:5000
